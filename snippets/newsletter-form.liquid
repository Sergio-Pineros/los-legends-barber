{% comment %}
  Renders Shopify native customer newsletter form.
  Accepts:
  - dark: {Boolean} Dark theme style
{% endcomment %}

{%- assign form_id = 'NewsletterForm-' | append: section.id -%}

{%- form 'customer', id: form_id, class: 'w-full' -%}
  <input type="hidden" name="contact[tags]" value="newsletter">

  {%- if form.posted_successfully? -%}
    <p class="text-sm font-medium {% if dark %}text-canvas{% else %}text-navy{% endif %}" role="status">
      You're on the list. Thank you for subscribing!
    </p>
  {%- else -%}
    <div class="flex items-center border-b {% if dark %}border-canvas/30 focus-within:border-canvas{% else %}border-ink/30 focus-within:border-ink{% endif %} transition-colors">
      <input
        type="email"
        name="contact[email]"
        id="{{ form_id }}-email"
        value="{{ form.email }}"
        required
        placeholder="Email address"
        aria-label="Email address"
        autocorrect="off"
        autocapitalize="off"
        autocomplete="email"
        class="flex-1 bg-transparent py-4 text-sm outline-none {% if dark %}text-canvas placeholder:text-canvas/40{% else %}text-ink placeholder:text-mute{% endif %}"
        {% if form.errors %}
          aria-invalid="true"
          aria-describedby="{{ form_id }}-error"
        {% endif %}
      >
      <button
        type="submit"
        class="eyebrow text-[11px] pl-4 py-4 transition-opacity {% if dark %}text-canvas{% else %}text-ink{% endif %}"
      >
        Subscribe &rarr;
      </button>
    </div>

    {%- if form.errors -%}
      <p id="{{ form_id }}-error" class="mt-3 text-xs text-red-500" role="alert">
        {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
      </p>
    {%- endif -%}
  {%- endif -%}
{%- endform -%}
