<section class="all-products-section page-container pt-24 lg:pt-32" style="padding-top: 6rem;">
  <div class="reveal flex items-end justify-between gap-6 mb-10" style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2.5rem;">
    <div>
      <p class="eyebrow text-mute" style="color: var(--color-mute);">{{ section.settings.eyebrow | default: "Everything" }}</p>
      <h2 class="display text-4xl sm:text-5xl lg:text-6xl mt-3" style="font-size: clamp(2.25rem, 5vw, 3.75rem); margin-top: 0.75rem;">
        {{ section.settings.heading_prefix | default: "The full" }} <span class="serif-accent text-navy" style="color: var(--color-navy);">{{ section.settings.heading_accent | default: "line." }}</span>
      </h2>
    </div>
    <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="eyebrow text-[11px] link-line pb-1 shrink-0" style="font-size: 11px; padding-bottom: 0.25rem;">
      Shop all
    </a>
  </div>

  {%- assign collection = section.settings.collection | default: collections.all -%}
  {%- assign limit = section.settings.products_to_show | default: 6 -%}

  <div class="all-products-grid grid grid-cols-2 md:grid-cols-3 gap-x-4 gap-y-10 sm:gap-x-6" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.5rem; row-gap: 2.5rem;">
    {%- for product in collection.products limit: limit -%}
      <div class="reveal" style="--reveal-delay: {{ forloop.index0 | modulo: 3 | times: 80 }}ms;">
        {% render 'product-card', product: product %}
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .all-products-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
  }
</style>

{% schema %}
{
  "name": "All Products Strip",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Everything"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading Prefix",
      "default": "The full"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent",
      "default": "line."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (defaults to All Products)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "All Products Strip"
    }
  ]
}
{% endschema %}
