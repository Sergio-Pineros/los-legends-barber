<div class="main-cart-section page-container pt-10 sm:pt-16 pb-20" style="padding-top: 3.5rem; padding-bottom: 5rem;">
  <div class="flex items-end justify-between gap-6" style="display: flex; align-items: flex-end; justify-content: space-between;">
    <h1 class="display text-5xl sm:text-6xl lg:text-7xl" style="font-size: clamp(2.5rem, 6vw, 4.5rem);">
      Your <span class="serif-accent text-navy" style="color: var(--color-navy);">bag</span>
      <span class="serif-accent text-mute text-[0.45em] align-top ml-3" style="font-size: 0.45em; vertical-align: top; margin-left: 0.75rem; color: var(--color-mute);">
        (<span class="cart-count-badge">{{ cart.item_count }}</span>)
      </span>
    </h1>
    <a href="{{ routes.all_products_collection_url }}" class="eyebrow text-[11px] link-line pb-1 shrink-0" style="font-size: 11px; padding-bottom: 0.25rem;">
      Continue shopping
    </a>
  </div>

  {%- if cart.item_count == 0 -%}
    <div class="py-28 text-center" style="padding-top: 7rem; padding-bottom: 7rem; text-align: center;">
      <p class="serif-accent text-3xl sm:text-4xl text-ink-soft" style="font-size: clamp(1.75rem, 4vw, 2.5rem); color: var(--color-ink-soft);">
        Your bag is empty.
      </p>
      <p class="mt-3 text-sm text-mute" style="margin-top: 0.75rem; font-size: 0.875rem; color: var(--color-mute);">
        Start with the heavyweight hoodie.
      </p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary mt-8" style="margin-top: 2rem;">
        Shop the collection
      </a>
    </div>
  {%- else -%}
    <div class="cart-layout-grid mt-12 grid lg:grid-cols-12 gap-10 lg:gap-16" style="margin-top: 3rem; display: grid; gap: 2.5rem;">
      
      <!-- LINE ITEMS LIST -->
      <form action="{{ routes.cart_url }}" method="post" id="cart" class="cart-items-col lg:col-span-7">
        <ul class="divide-y divide-line" style="display: flex; flex-direction: column;">
          {%- for item in cart.items -%}
            <li class="flex gap-5 py-6 first:pt-0" style="display: flex; gap: 1.25rem; padding-top: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-line);">
              <a href="{{ item.url }}" class="cart-item-thumb w-28 sm:w-36 shrink-0 overflow-hidden rounded-xl bg-paper border border-line aspect-square relative block" style="width: clamp(7rem, 15vw, 9rem); flex-shrink: 0; aspect-ratio: 1; border-radius: 0.75rem; overflow: hidden; background: var(--color-paper); border: 1px solid var(--color-line);">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 280 | image_tag: class: 'object-cover w-full h-full', alt: item.title | escape }}
                {%- endif -%}
              </a>
              <div class="flex flex-1 flex-col justify-between min-w-0" style="display: flex; flex: 1; flex-direction: column; justify-content: space-between; min-width: 0;">
                <div class="flex justify-between gap-4" style="display: flex; justify-content: space-between; gap: 1rem;">
                  <div class="min-w-0">
                    <a href="{{ item.url }}" class="block text-sm font-semibold leading-snug tracking-tight truncate hover:underline" style="font-size: 0.875rem; font-weight: 600;">
                      {{ item.product.title }}
                    </a>
                    {%- if item.variant.title != blank and item.variant.title != 'Default Title' -%}
                      <p class="mt-1 text-xs text-mute" style="margin-top: 0.25rem; font-size: 0.75rem; color: var(--color-mute);">
                        {{ item.variant.title }}
                      </p>
                    {%- endif -%}
                  </div>
                  <p class="text-sm font-medium tabular-nums shrink-0" style="font-size: 0.875rem; font-weight: 500;">
                    {{ item.final_line_price | money }}
                  </p>
                </div>

                <div class="flex items-center justify-between mt-4" style="display: flex; align-items: center; justify-content: space-between; margin-top: 1rem;">
                  <div class="inline-flex items-center rounded-full border border-line-strong" style="display: inline-flex; align-items: center; border-radius: 9999px; border: 1px solid var(--color-line-strong);">
                    <a
                      href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}"
                      class="h-9 w-9 grid place-items-center text-lg leading-none hover:bg-ink hover:text-white rounded-full transition-colors"
                      style="width: 36px; height: 36px; display: grid; place-items: center; border-radius: 9999px;"
                    >
                      &minus;
                    </a>
                    <span class="w-8 text-center text-sm tabular-nums" style="width: 32px; text-align: center; font-size: 0.875rem;">
                      {{ item.quantity }}
                    </span>
                    <a
                      href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}"
                      class="h-9 w-9 grid place-items-center text-lg leading-none hover:bg-ink hover:text-white rounded-full transition-colors"
                      style="width: 36px; height: 36px; display: grid; place-items: center; border-radius: 9999px;"
                    >
                      +
                    </a>
                  </div>
                  <a
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                    class="text-[11px] uppercase tracking-[0.18em] text-mute hover:text-ink transition-colors link-line"
                    style="font-size: 11px; letter-spacing: 0.18em; color: var(--color-mute);"
                  >
                    Remove
                  </a>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </form>

      <!-- SUMMARY ASIDE -->
      <aside class="cart-summary-col lg:col-span-5 lg:col-start-8">
        <div class="lg:sticky lg:top-28 rounded-[24px] border border-line bg-paper p-6 sm:p-8" style="border-radius: 24px; border: 1px solid var(--color-line); background: var(--color-paper); padding: clamp(1.5rem, 4vw, 2rem);">
          <h2 class="display text-2xl" style="font-size: 1.5rem;">Summary</h2>
          <dl class="mt-6 space-y-3 text-sm" style="margin-top: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; font-size: 0.875rem;">
            <div class="flex justify-between" style="display: flex; justify-content: space-between;">
              <dt class="text-mute" style="color: var(--color-mute);">Subtotal</dt>
              <dd class="tabular-nums font-medium">{{ cart.total_price | money }}</dd>
            </div>
            <div class="flex justify-between" style="display: flex; justify-content: space-between;">
              <dt class="text-mute" style="color: var(--color-mute);">Shipping</dt>
              <dd class="text-mute" style="color: var(--color-mute);">Calculated at checkout</dd>
            </div>
          </dl>

          <div class="mt-6 pt-6 border-t border-line flex justify-between items-baseline" style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line); display: flex; justify-content: space-between; align-items: baseline;">
            <span class="eyebrow">Total</span>
            <span class="text-2xl font-semibold tabular-nums" style="font-size: 1.5rem; font-weight: 600;">{{ cart.total_price | money }}</span>
          </div>

          <form action="{{ routes.cart_url }}" method="post" class="mt-6" style="margin-top: 1.5rem;">
            <button type="submit" name="checkout" class="btn btn-primary w-full h-14" style="width: 100%; height: 56px;">
              Checkout securely
            </button>
          </form>

          <p class="mt-4 text-[11px] text-mute text-center leading-relaxed" style="margin-top: 1rem; font-size: 11px; color: var(--color-mute); text-align: center; line-height: 1.5;">
            You&apos;ll complete payment on our secure Shopify checkout.
          </p>
        </div>
      </aside>

    </div>
  {%- endif -%}
</div>

<style>
  @media (min-width: 1024px) {
    .cart-layout-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr)) !important;
    }
    .cart-items-col {
      grid-column: span 7 / span 7 !important;
    }
    .cart-summary-col {
      grid-column: 8 / span 5 !important;
    }
  }
</style>

{% schema %}
{
  "name": "Main Cart",
  "settings": []
}
{% endschema %}
