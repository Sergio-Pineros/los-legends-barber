<section class="featured-collection-section page-container pt-20 lg:pt-28" style="padding-top: 5rem;">
  <div class="reveal flex items-end justify-between gap-6 mb-10" style="display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 2.5rem;">
    <div>
      <p class="eyebrow text-mute" style="color: var(--color-mute);">{{ section.settings.eyebrow | default: "The latest" }}</p>
      <h2 class="display text-4xl sm:text-5xl lg:text-6xl mt-3" style="font-size: clamp(2.25rem, 5vw, 3.75rem); margin-top: 0.75rem;">
        {{ section.settings.heading_prefix | default: "New" }} <span class="serif-accent text-navy" style="color: var(--color-navy);">{{ section.settings.heading_accent | default: "arrivals" }}</span>
      </h2>
    </div>
    <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="eyebrow text-[11px] link-line pb-1 shrink-0" style="font-size: 11px; padding-bottom: 0.25rem;">
      View all
    </a>
  </div>

  {%- assign collection = section.settings.collection -%}
  {%- assign limit = section.settings.products_to_show | default: 4 -%}

  <div class="products-grid grid grid-cols-2 xl:grid-cols-4 gap-x-4 gap-y-10 sm:gap-x-6" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 1.5rem; row-gap: 2.5rem;">
    {%- if collection != blank and collection.products.size > 0 -%}
      {%- for product in collection.products limit: limit -%}
        <div class="reveal" style="--reveal-delay: {{ forloop.index0 | times: 80 }}ms;">
          {% render 'product-card', product: product, priority: forloop.first %}
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for product in collections.all.products limit: limit -%}
        <div class="reveal" style="--reveal-delay: {{ forloop.index0 | times: 80 }}ms;">
          {% render 'product-card', product: product, priority: forloop.first %}
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

<style>
  @media (min-width: 1280px) {
    .products-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The latest"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading Prefix",
      "default": "New"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent",
      "default": "arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
