<section class="brand-statement-section page-container pt-24 lg:pt-36" style="padding-top: 6rem;">
  <div class="brand-grid grid lg:grid-cols-12 gap-10 items-center" style="display: grid; gap: 2.5rem; align-items: center;">
    
    <!-- IMAGE -->
    <div class="reveal brand-image-col lg:col-span-6 order-2 lg:order-1" style="order: 2;">
      <div class="relative rounded-[28px] overflow-hidden bg-paper border border-line" style="position: relative; border-radius: 28px; overflow: hidden; background: var(--color-paper); border: 1px solid var(--color-line);">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag:
            class: 'w-full h-auto',
            loading: 'lazy',
            alt: section.settings.image.alt | default: 'Legends Apparel'
          }}
        {%- else -%}
          {{ 'hero.jpg' | asset_url | image_tag:
            class: 'w-full h-auto',
            loading: 'lazy',
            alt: 'Legends Apparel — Made To Inspire, Lifestyle Clothing, Cut Different, LA'
          }}
        {%- endif -%}
      </div>
    </div>

    <!-- COPY -->
    <div class="reveal brand-copy-col lg:col-span-5 lg:col-start-8 order-1 lg:order-2" style="order: 1; --reveal-delay: 100ms;">
      <p class="eyebrow text-mute" style="color: var(--color-mute);">{{ section.settings.eyebrow | default: "The brand" }}</p>
      
      <h2 class="display text-4xl sm:text-5xl lg:text-6xl mt-4 leading-[0.95]" style="font-size: clamp(2.25rem, 5vw, 3.75rem); line-height: 0.95; margin-top: 1rem;">
        {{ section.settings.heading_prefix | default: "Built for those who" }} <span class="serif-accent text-navy" style="color: var(--color-navy);">{{ section.settings.heading_accent | default: "move with purpose." }}</span>
      </h2>
      
      <p class="mt-6 text-[15px] leading-relaxed text-ink-soft max-w-md" style="margin-top: 1.5rem; font-size: 15px; line-height: 1.6; color: var(--color-ink-soft); max-width: 28rem;">
        {{ section.settings.text | default: "Legends Apparel is lifestyle clothing from Los Angeles. Heavyweight construction, relaxed cuts and a minimal LEGENDS mark — made to be worn every day, anywhere." }}
      </p>

      <ul class="mt-8 grid grid-cols-3 gap-4 max-w-md" style="margin-top: 2rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; max-width: 28rem;">
        <li class="border-t border-ink pt-3" style="border-top: 1px solid var(--color-ink); padding-top: 0.75rem;">
          <p class="text-sm font-semibold tracking-tight" style="font-size: 0.875rem; font-weight: 600;">Heavyweight</p>
          <p class="text-xs text-mute mt-0.5" style="font-size: 0.75rem; color: var(--color-mute); margin-top: 0.125rem;">Premium feel</p>
        </li>
        <li class="border-t border-ink pt-3" style="border-top: 1px solid var(--color-ink); padding-top: 0.75rem;">
          <p class="text-sm font-semibold tracking-tight" style="font-size: 0.875rem; font-weight: 600;">Relaxed</p>
          <p class="text-xs text-mute mt-0.5" style="font-size: 0.75rem; color: var(--color-mute); margin-top: 0.125rem;">Oversized fit</p>
        </li>
        <li class="border-t border-ink pt-3" style="border-top: 1px solid var(--color-ink); padding-top: 0.75rem;">
          <p class="text-sm font-semibold tracking-tight" style="font-size: 0.875rem; font-weight: 600;">Everyday</p>
          <p class="text-xs text-mute mt-0.5" style="font-size: 0.75rem; color: var(--color-mute); margin-top: 0.125rem;">Made to layer</p>
        </li>
      </ul>

      <a href="{{ section.settings.button_link | default: '/pages/about' }}" class="btn btn-outline mt-10" style="margin-top: 2.5rem;">
        {{ section.settings.button_text | default: "Our story" }}
      </a>
    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .brand-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr)) !important;
    }
    .brand-image-col {
      grid-column: span 6 / span 6 !important;
      order: 1 !important;
    }
    .brand-copy-col {
      grid-column: 8 / span 5 !important;
      order: 2 !important;
    }
  }
</style>

{% schema %}
{
  "name": "Brand Statement",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The brand"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading Prefix",
      "default": "Built for those who"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent",
      "default": "move with purpose."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Legends Apparel is lifestyle clothing from Los Angeles. Heavyweight construction, relaxed cuts and a minimal LEGENDS mark — made to be worn every day, anywhere."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Brand Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Brand Statement"
    }
  ]
}
{% endschema %}
