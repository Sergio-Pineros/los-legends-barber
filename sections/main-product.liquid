{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign color_option = product.options_by_name['Color'] -%}
{%- assign size_option = product.options_by_name['Size'] -%}

<div class="main-product-section page-container pt-10 sm:pt-16 pb-20" data-section-type="product" style="padding-top: 3.5rem; padding-bottom: 5rem;">
  <div class="product-layout-grid grid lg:grid-cols-12 gap-10 lg:gap-14" style="display: grid; gap: 2.5rem;">
    
    <!-- GALLERY -->
    <div class="product-gallery-col lg:col-span-7">
      <div class="product-gallery-sticky lg:sticky lg:top-24 flex flex-col-reverse sm:flex-row gap-4" style="display: flex; flex-direction: column-reverse; gap: 1rem;">
        
        <!-- THUMBNAILS -->
        {%- if product.media.size > 1 -%}
          <div class="gallery-thumbs flex sm:flex-col gap-3 sm:w-20 shrink-0 overflow-x-auto no-scrollbar" style="display: flex; gap: 0.75rem; overflow-x: auto; flex-shrink: 0;">
            {%- for media in product.media -%}
              <button
                type="button"
                data-thumb-img
                data-thumb-index="{{ forloop.index0 }}"
                data-img-color="{{ media.alt | escape }}"
                class="thumb-btn relative w-20 aspect-[4/5] shrink-0 rounded-xl overflow-hidden border transition-colors bg-paper {% if forloop.first %}border-ink active{% else %}border-line hover:border-line-strong{% endif %}"
                style="position: relative; width: 5rem; aspect-ratio: 4/5; flex-shrink: 0; border-radius: 0.75rem; overflow: hidden; background: var(--color-paper); border: 1px solid var(--color-line);"
              >
                {{ media | image_url: width: 160 | image_tag: class: 'object-contain w-full h-full', alt: media.alt | default: product.title | escape }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- MAIN IMAGE STACK -->
        <div class="gallery-main relative flex-1 aspect-[4/5] rounded-[24px] overflow-hidden bg-paper border border-line" style="position: relative; flex: 1; aspect-ratio: 4/5; border-radius: 24px; overflow: hidden; background: var(--color-paper); border: 1px solid var(--color-line);">
          {%- for media in product.media -%}
            <div
              data-gallery-img
              data-img-index="{{ forloop.index0 }}"
              data-img-color="{{ media.alt | escape }}"
              style="position: absolute; inset: 0; width: 100%; height: 100%; {% unless forloop.first %}display: none;{% endunless %}"
            >
              {{ media | image_url: width: 1200 | image_tag:
                class: 'object-contain w-full h-full',
                loading: forloop.first ? 'eager' : 'lazy',
                alt: media.alt | default: product.title | escape
              }}
            </div>
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-contain' }}
          {%- endfor -%}
        </div>
      </div>
    </div>

    <!-- PRODUCT DETAILS & BUY BOX -->
    <div class="product-info-col lg:col-span-5">
      <p class="eyebrow text-mute" style="color: var(--color-mute);">Legends Worldwide</p>
      <h1 class="display text-4xl sm:text-5xl mt-3 leading-[0.95]" style="font-size: clamp(2.25rem, 5vw, 3.25rem); line-height: 0.95; margin-top: 0.75rem;">
        {{ product.title }}
      </h1>
      
      <div class="mt-4 flex items-center gap-4" style="margin-top: 1rem; display: flex; align-items: center; gap: 1rem;">
        <p class="product-current-price text-xl font-medium tabular-nums" style="font-size: 1.25rem; font-weight: 500;">
          {{ current_variant.price | money }}
        </p>
        <span class="h-4 w-px bg-line-strong" style="height: 1rem; width: 1px; background: var(--color-line-strong);"></span>
        <p class="text-xs text-mute" style="font-size: 0.75rem; color: var(--color-mute);">
          {{ product.metafields.custom.tagline | default: product.type | default: "Built for everyday comfort" }}
        </p>
      </div>

      <!-- SHOPIFY NATIVE FORM -->
      {%- form 'product', product, id: 'product_form', class: 'product-form mt-8' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">

        <!-- COLOR SELECTOR -->
        {%- if color_option != blank and color_option.values.size > 0 -%}
          <div class="color-picker-wrap">
            <div class="flex items-center justify-between" style="display: flex; align-items: center; justify-content: space-between;">
              <p class="eyebrow text-[10px]" style="font-size: 10px;">Color</p>
              <p class="active-color-label text-xs text-ink-soft" style="font-size: 0.75rem; color: var(--color-ink-soft);">
                {{ color_option.values.first }}
              </p>
            </div>
            <div class="mt-3 flex flex-wrap gap-2.5" style="margin-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.625rem;">
              {%- for c in color_option.values -%}
                {%- liquid
                  assign hex = '#ccc'
                  case c
                    when 'Black'
                      assign hex = '#111111'
                    when 'White'
                      assign hex = '#f4f4f4'
                    when 'Blackish Green'
                      assign hex = '#1f2a24'
                    when 'Pink'
                      assign hex = '#e7b6c4'
                    when 'Blue'
                      assign hex = '#6f8fbf'
                    when 'Flower Gray'
                      assign hex = '#b9b6ae'
                    when 'Apricot'
                      assign hex = '#e9d3b8'
                    when 'Camel'
                      assign hex = '#b48a5a'
                  endcase
                -%}
                <button
                  type="button"
                  data-color-swatch="{{ c | escape }}"
                  title="{{ c | escape }}"
                  class="swatch-btn relative h-9 w-9 rounded-full grid place-items-center border transition-all {% if forloop.first %}border-ink active scale-105{% else %}border-line-strong hover:border-ink{% endif %}"
                  style="width: 36px; height: 36px; border-radius: 9999px; display: grid; place-items: center; border: 1px solid var(--color-line-strong); background: transparent;"
                >
                  <span class="h-6 w-6 rounded-full border border-black/10" style="width: 24px; height: 24px; border-radius: 9999px; background-color: {{ hex }};"></span>
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <!-- SIZE SELECTOR -->
        {%- if size_option != blank and size_option.values.size > 0 -%}
          <div class="size-picker-wrap mt-7" style="margin-top: 1.75rem;">
            <div class="flex items-center justify-between" style="display: flex; align-items: center; justify-content: space-between;">
              <p class="eyebrow text-[10px]" style="font-size: 10px;">Size</p>
              <button type="button" data-tab-target="size" class="text-xs text-mute link-line hover:text-ink" style="font-size: 0.75rem; color: var(--color-mute);">
                Size guide
              </button>
            </div>
            <div class="mt-3 grid grid-cols-6 gap-2" style="margin-top: 0.75rem; display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.5rem;">
              {%- for s in size_option.values -%}
                <button
                  type="button"
                  data-size-btn="{{ s | escape }}"
                  class="size-btn h-11 rounded-xl border text-xs font-semibold tracking-wide transition-all border-line-strong hover:border-ink"
                  style="height: 44px; border-radius: 0.75rem; border: 1px solid var(--color-line-strong); font-size: 0.75rem; font-weight: 600;"
                >
                  {{ s }}
                </button>
              {%- endfor -%}
            </div>
            <p class="mt-3 text-xs text-mute" style="margin-top: 0.75rem; font-size: 0.75rem; color: var(--color-mute);">
              Relaxed fit. For a more fitted look, consider sizing down.
            </p>
          </div>
        {%- endif -%}

        <!-- CTA ADD TO BAG -->
        <div class="product-cta-wrap mt-8" style="margin-top: 2rem;">
          <button
            type="submit"
            name="add"
            class="product-add-btn btn btn-primary w-full h-14"
            style="width: 100%; height: 56px; font-size: 0.8125rem;"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {%- if current_variant.available -%}
              Add to bag &middot; {{ current_variant.price | money }}
            {%- else -%}
              Sold out
            {%- endif -%}
          </button>
        </div>
      {%- endform -%}

      <!-- BADGES PILLARS -->
      <ul class="mt-4 grid grid-cols-3 gap-3 text-center" style="margin-top: 1rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; text-align: center;">
        <li class="rounded-2xl border border-line bg-paper py-3" style="border-radius: 1rem; border: 1px solid var(--color-line); background: var(--color-paper); padding: 0.75rem;">
          <p class="text-sm font-semibold tracking-tight" style="font-size: 0.875rem; font-weight: 600;">Unisex</p>
          <p class="eyebrow text-[9px] text-mute mt-0.5" style="font-size: 9px; color: var(--color-mute);">Sizing</p>
        </li>
        <li class="rounded-2xl border border-line bg-paper py-3" style="border-radius: 1rem; border: 1px solid var(--color-line); background: var(--color-paper); padding: 0.75rem;">
          <p class="text-sm font-semibold tracking-tight" style="font-size: 0.875rem; font-weight: 600;">Relaxed</p>
          <p class="eyebrow text-[9px] text-mute mt-0.5" style="font-size: 9px; color: var(--color-mute);">Fit</p>
        </li>
        <li class="rounded-2xl border border-line bg-paper py-3" style="border-radius: 1rem; border: 1px solid var(--color-line); background: var(--color-paper); padding: 0.75rem;">
          <p class="text-sm font-semibold tracking-tight" style="font-size: 0.875rem; font-weight: 600;">LA</p>
          <p class="eyebrow text-[9px] text-mute mt-0.5" style="font-size: 9px; color: var(--color-mute);">Studio</p>
        </li>
      </ul>

      <!-- TABS -->
      <div class="product-tabs-wrap mt-10 border-t border-line" style="margin-top: 2.5rem; border-top: 1px solid var(--color-line);">
        <div class="flex gap-6 border-b border-line" style="display: flex; gap: 1.5rem;">
          <button type="button" data-tab-target="details" class="tab-btn eyebrow text-[10px] py-4 border-t -mt-px transition-colors border-ink text-ink active" style="font-size: 10px; padding: 1rem 0; border-top: 2px solid var(--color-ink);">
            Details
          </button>
          <button type="button" data-tab-target="size" class="tab-btn eyebrow text-[10px] py-4 border-t -mt-px transition-colors border-transparent text-mute hover:text-ink" style="font-size: 10px; padding: 1rem 0; border-top: 2px solid transparent; color: var(--color-mute);">
            Size guide
          </button>
          <button type="button" data-tab-target="care" class="tab-btn eyebrow text-[10px] py-4 border-t -mt-px transition-colors border-transparent text-mute hover:text-ink" style="font-size: 10px; padding: 1rem 0; border-top: 2px solid transparent; color: var(--color-mute);">
            Fabric &amp; care
          </button>
        </div>

        <div class="tab-panels-content pt-5 text-sm leading-relaxed text-ink-soft" style="padding-top: 1.25rem; font-size: 0.875rem; line-height: 1.6; color: var(--color-ink-soft);">
          <!-- DETAILS PANEL -->
          <div data-tab-panel="details" class="tab-panel space-y-4">
            {{ product.description }}
          </div>

          <!-- SIZE GUIDE PANEL -->
          <div data-tab-panel="size" class="tab-panel overflow-x-auto" style="display: none;">
            <table class="size-table text-xs min-w-[420px]" style="width: 100%; font-size: 0.75rem;">
              <thead>
                <tr class="eyebrow text-[9px] text-mute">
                  <th>Inches</th>
                  <th>S</th>
                  <th>M</th>
                  <th>L</th>
                  <th>XL</th>
                  <th>2XL</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="font-medium text-ink">Length</td>
                  <td>27.5</td>
                  <td>28.3</td>
                  <td>29.1</td>
                  <td>29.9</td>
                  <td>30.7</td>
                </tr>
                <tr>
                  <td class="font-medium text-ink">Chest</td>
                  <td>25.6</td>
                  <td>26.4</td>
                  <td>27.2</td>
                  <td>27.9</td>
                  <td>28.7</td>
                </tr>
                <tr>
                  <td class="font-medium text-ink">Shoulder</td>
                  <td>25.2</td>
                  <td>26.0</td>
                  <td>26.8</td>
                  <td>27.6</td>
                  <td>28.3</td>
                </tr>
                <tr>
                  <td class="font-medium text-ink">Sleeve</td>
                  <td>20.9</td>
                  <td>21.3</td>
                  <td>21.6</td>
                  <td>22.0</td>
                  <td>22.4</td>
                </tr>
              </tbody>
            </table>
            <p class="mt-4 text-xs text-mute" style="margin-top: 1rem; font-size: 0.75rem; color: var(--color-mute);">
              Garment measurements, laid flat. Allow &plusmn;1&ndash;2 cm variance.
            </p>
          </div>

          <!-- FABRIC & CARE PANEL -->
          <div data-tab-panel="care" class="tab-panel" style="display: none;">
            <dl class="divide-y divide-line" style="display: flex; flex-direction: column;">
              <div class="grid grid-cols-[110px_1fr] gap-4 py-3" style="display: grid; grid-template-columns: 110px 1fr; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--color-line);">
                <dt class="eyebrow text-[10px] text-mute pt-0.5">Gender</dt>
                <dd>Unisex</dd>
              </div>
              <div class="grid grid-cols-[110px_1fr] gap-4 py-3" style="display: grid; grid-template-columns: 110px 1fr; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--color-line);">
                <dt class="eyebrow text-[10px] text-mute pt-0.5">Weight</dt>
                <dd>Heavyweight</dd>
              </div>
              <div class="grid grid-cols-[110px_1fr] gap-4 py-3" style="display: grid; grid-template-columns: 110px 1fr; gap: 1rem; padding: 0.75rem 0;">
                <dt class="eyebrow text-[10px] text-mute pt-0.5">Care</dt>
                <dd>Machine wash at 30&deg;C (gentle cycle). Do not bleach. Tumble dry low. Iron at low temperature, avoid ironing on print.</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- JSON SCRIPT DATA FOR THEME.JS VARIANT INTERACTIVITY -->
  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>
</div>

<style>
  @media (min-width: 1024px) {
    .product-layout-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr)) !important;
    }
    .product-gallery-col {
      grid-column: span 7 / span 7 !important;
    }
    .product-info-col {
      grid-column: span 5 / span 5 !important;
    }
    .product-gallery-sticky {
      position: sticky !important;
      top: 6rem !important;
      flex-direction: row !important;
    }
    .gallery-thumbs {
      flex-direction: column !important;
      width: 5rem !important;
    }
  }
  .size-btn.active {
    background: var(--color-ink) !important;
    color: var(--color-canvas) !important;
    border-color: var(--color-ink) !important;
  }
  .tab-btn.active {
    border-color: var(--color-ink) !important;
    color: var(--color-ink) !important;
  }
</style>

{% schema %}
{
  "name": "Main Product",
  "settings": []
}
{% endschema %}
